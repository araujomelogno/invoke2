# Cloud Run — servicio ari. Se construye desde la raíz del repositorio:
#   gcloud builds submit --tag $REGION-docker.pkg.dev/$PROYECTO/invoke/ari -f infra/cloudrun/Dockerfile.ari .
FROM python:3.12-slim
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
WORKDIR /app
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
COPY invoke/ invoke/
COPY schemas/ schemas/
COPY services/__init__.py services/__init__.py
COPY services/ari/ services/ari/
USER nobody
CMD ["python", "services/ari/main.py"]
