# Cloud Run — servicio pacer. Se construye con infra/cloudrun/cloudbuild.yaml
# (docs/despliegue.md, paso 11), desde la raíz del repositorio.
FROM python:3.12-slim
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
WORKDIR /app
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
COPY invoke/ invoke/
COPY schemas/ schemas/
COPY services/__init__.py services/__init__.py
COPY services/pacer/ services/pacer/
USER nobody
CMD ["python", "services/pacer/main.py"]
