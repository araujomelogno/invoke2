{
  "hosting": {
    "public": "web",
    "ignore": ["package.json", "tipos.d.ts", "**/.*"],
    "cleanUrls": false,
    "rewrites": [
      { "source": "/api/**", "function": { "functionId": "api", "region": "southamerica-east1" } }
    ],
    "headers": [
      { "source": "**/*.@(js|css)", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
      { "source": "**", "headers": [
        { "key": "Permissions-Policy", "value": "microphone=(self)" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "same-origin" }
      ] }
    ]
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "invoke",
      "runtime": "python312",
      "predeploy": ["bash scripts/preparar_functions.sh"]
    }
  ]
}
