# Copiar a .env para desarrollo local. En GCP estas variables vienen de Secret Manager.
DATABASE_URL=postgresql://postgres:invoke@127.0.0.1:5432/invoke
INVOKE_DB_ROL=invoke_app
INVOKE_AUTH_DEV=1
ARI_URL=http://127.0.0.1:8088/ari
ARI_USUARIO=invoke
ARI_CLAVE=cambiar
SIP_WSS=wss://pbx.invoke.local:8089/ws
SIP_DOMINIO=pbx.invoke.local
INVOKE_TRUNK=PJSIP/{numero}@trunk
TURN_URLS=turn:turn.invoke.local:3478?transport=udp,turns:turn.invoke.local:5349?transport=tcp
TURN_SECRETO=cambiar
STUN_URLS=stun:turn.invoke.local:3478
# Plantillas de Asterisk (en producción: /etc/invoke/pbx.conf y Secret Manager, docs/despliegue.md, paso 8)
PBX_IP_PUBLICA=203.0.113.10
PBX_IP_PRIVADA=127.0.0.1
TRUNK_HOST=sip.proveedor.example
TRUNK_IP=198.51.100.20
TRUNK_DOMINIO=sip.proveedor.example
TRUNK_USUARIO=cambiar
TRUNK_CLAVE=cambiar
DB_HOST=127.0.0.1
DB_PUERTO=5432
DB_NOMBRE=invoke
DB_CLAVE_ASTERISK=cambiar
# PSTN simulada (docs/despliegue.md, apéndice A). Con 1, usar INVOKE_TRUNK=Local/{numero}@invoke-lab-pstn
INVOKE_PBX_LABORATORIO=0
